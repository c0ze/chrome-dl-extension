{
  "manifest_version": 3,
  "name": "X/Twitter & Facebook Video Downloader Bridge",
  "version": "0.4.0",
  "description": "Send X/Twitter and Facebook URLs to a local yt-dlp native host with browser cookies.",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Download current page with yt-dlp"
  },
  "options_page": "options.html"
}
