{
  "manifest_version": 3,
  "name": "Twitter Video Downloader Bridge",
  "version": "0.1.0",
  "description": "Send X/Twitter URLs to a local yt-dlp native host with browser cookies.",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Download current page with yt-dlp"
  },
  "options_page": "options.html"
}
